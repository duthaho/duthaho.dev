---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import { getSortedPosts } from '../lib/posts';

const posts = await getSortedPosts();
const pinned = posts.find((p) => p.data.pinned);
const feed = posts; // full list, newest first

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const shortDate = (d: Date) => `${String(d.getUTCDate()).padStart(2, '0')} ${MONTHS[d.getUTCMonth()]}`;
const pad = (n: number) => String(n).padStart(2, '0');

const title = 'Nhật ký dev — After-hours thoughts';
const description = 'After-hours notes on AI, engineering, and the developer craft — written from a personal point of view.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Nhật ký dev',
  alternateName: 'After-hours thoughts',
  url: 'https://duthaho.dev/',
  description,
  inLanguage: 'en',
  author: { '@type': 'Person', name: 'duthaho', url: 'https://duthaho.dev/about/' },
  publisher: { '@type': 'Person', name: 'duthaho', url: 'https://duthaho.dev/about/' },
  image: 'https://duthaho.dev/og-default.jpg',
};
---
<BaseLayout title={title} description={description} path="/" bodyClass="feed-page" jsonLd={jsonLd}>
  <main class="feed-shell">
    <aside class="feed-sidebar">
      <div class="feed-sidebar__inner">
        <section class="feed-block">
          <h3 class="feed-block__title">Workbench</h3>
          <p class="feed-block__hint">Things I'm building outside work hours.</p>
          <ul class="workbench">
            <li>
              <a href="https://claudekit.duthaho.dev" target="_blank" rel="noopener noreferrer">
                <span class="workbench__name">claudekit.duthaho.dev</span>
                <span class="workbench__desc">Claude Code plugin · 35 skills, 24 agents</span>
              </a>
            </li>
          </ul>
        </section>

        <section class="feed-block">
          <h3 class="feed-block__title">Archive</h3>
          <ul class="archive">
            <li><a href="#feed">2026 <span class="archive__count">{feed.length}</span></a></li>
          </ul>
        </section>

        <section class="feed-block">
          <h3 class="feed-block__title">Subscribe</h3>
          <ul class="sub-links">
            <li><a href="/rss.xml">RSS feed</a></li>
            <li><a href="https://duthaho.substack.com/" target="_blank" rel="noopener noreferrer">Substack</a></li>
          </ul>
        </section>
      </div>
    </aside>

    <div class="feed-main">
      {pinned && (
        <article class="discussion-pinned reveal">
          <header class="discussion-pinned__head">
            <span class="chip chip--pinned">
              <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M9.585.687a2.25 2.25 0 0 1 3.182 0l2.546 2.546a2.25 2.25 0 0 1 0 3.182L13.06 8.667l.005.005-1.06 1.061-3.5 3.5-1.06-1.06.354-.355-2.474-2.474-3.91 1.477a.75.75 0 0 1-.81-.169L.74 10.21a.75.75 0 0 1-.169-.81l1.477-3.91L4.95 1.586l1.06-1.06.005.004L9.585.687Z"/></svg>
              Pinned
            </span>
            <span class="discussion-pinned__num">#{pad(pinned.data.num)}</span>
          </header>
          <a class="discussion-pinned__link" href={`/${pinned.id}/`}>
            <span class="discussion-pinned__slug">{pinned.data.filename ?? `${pinned.id}.md`}</span>
            <h2 class="discussion-pinned__title">
              {pinned.data.title}{pinned.data.titleEm && <> <em>{pinned.data.titleEm}</em></>}
            </h2>
            <p class="discussion-pinned__excerpt">{pinned.data.description}</p>
          </a>
          <div class="discussion-pinned__meta">
            <time datetime={pinned.data.date.toISOString().slice(0, 10)}>{shortDate(pinned.data.date)} {pinned.data.date.getUTCFullYear()}</time>
          </div>
        </article>
      )}

      <Newsletter source="home" />

      <section class="feed reveal-stagger" id="feed">
        <header class="feed__head">
          <h3 class="feed__title">Recent</h3>
          <span class="feed__count">{feed.length}</span>
        </header>

        {feed.map((post) => (
          <a class="discussion-card reveal" href={`/${post.id}/`}>
            <span class="discussion-card__num">#{pad(post.data.num)}</span>
            <div class="discussion-card__body">
              <h4 class="discussion-card__title">
                {post.data.title}{post.data.titleEm && <> <em>{post.data.titleEm}</em></>}
              </h4>
              <p class="discussion-card__excerpt">{post.data.description}</p>
            </div>
            <div class="discussion-card__meta">
              <time datetime={post.data.date.toISOString().slice(0, 10)}>{shortDate(post.data.date)}</time>
            </div>
          </a>
        ))}
      </section>
    </div>
  </main>

  <footer class="feed-foot" slot="footer">
    <div class="feed-foot__inner">
      <span>Nhật ký dev · Written after dark</span>
      <span><em>Set in Fraunces &amp; JetBrains Mono.</em></span>
      <span>© 2026 duthaho</span>
    </div>
  </footer>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';

const EMAIL = 'hopit.bkdn@gmail.com';
const { personal, stats = [], coreSkills = [], techStack = [], experience = [], projects = [], articles = [], social = [], footer = {} } = profile as any;

const enDash = (s: string) => String(s).replace(/\s*-\s*/g, '–');
const bare = (u: string) => String(u).replace(/^https?:\/\//, '').replace(/\/$/, '');
const stripTags = (s: string) => String(s).replace(/<[^>]+>/g, '');
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const monthYear = (iso: string) => {
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? '' : `${MONTHS[d.getMonth()]} ${d.getFullYear()}`;
};

const rev = `${footer.year || new Date().getFullYear()}.07`;
const summary = stripTags(personal.about.paragraphs[0]);

const title = `Résumé — ${personal.name}, ${personal.title}`;
const description = `Résumé of ${personal.name} (@duthaho) — ${personal.title}, ${personal.location}.`;
---
<BaseLayout title={title} description={description} path="/cv/" bodyClass="article-page cv-page">
  <nav class="cv-toolbar" aria-label="Résumé actions">
    <a href="/about/">← Profile</a>
    <button class="cv-toolbar__primary" type="button" id="print-btn">Download PDF</button>
    <span class="cv-toolbar__hint">Tip: choose “Save as PDF” in the print dialog</span>
  </nav>

  <main class="cv-page-sheet" id="page">
    <header class="cv-head">
      <div>
        <h1 class="cv-head__name">{personal.name}</h1>
        <p class="cv-head__role">{personal.title}</p>
        <p class="cv-head__sheet">Résumé · REV {rev}</p>
      </div>
      <p class="cv-head__contact">
        <span>{personal.location}</span>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        {social.map((l: any) => (
          <a href={l.url} target="_blank" rel="noopener noreferrer">{bare(l.url)}</a>
        ))}
      </p>
    </header>

    <p class="cv-stats">
      {stats.map((s: any) => (<span><b>{s.value}</b> {s.label}</span>))}
    </p>

    <section class="cv-sec">
      <h2 class="cv-sec__title">Summary</h2>
      <p class="cv-summary">{summary}</p>
    </section>

    <section class="cv-sec">
      <h2 class="cv-sec__title">Skills</h2>
      <div class="cv-skills">
        <div class="cv-skills__row">
          <span class="cv-skills__label">Core</span>
          <span class="cv-skills__value">{coreSkills.map((s: any) => s.name).join(' · ')}</span>
        </div>
        <div class="cv-skills__row">
          <span class="cv-skills__label">Stack</span>
          <span class="cv-skills__value">{techStack.join(' · ')}</span>
        </div>
      </div>
    </section>

    <section class="cv-sec">
      <h2 class="cv-sec__title">Experience</h2>
      <div class="cv-exp">
        {experience.map((job: any) => (
          <article class="cv-job">
            <div class="cv-job__head">
              <h3 class="cv-job__role">{job.title}</h3>
              <span class="cv-job__co">{job.company}</span>
              <span class="cv-job__period">{enDash(job.period)}</span>
            </div>
            <p class="cv-job__summary">{job.summary}</p>
            <ul class="cv-job__bullets">
              {(job.achievements || []).map((a: string) => <li set:html={a} />)}
            </ul>
            <p class="cv-job__stack">{(job.stack || []).join(' · ')}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="cv-sec">
      <h2 class="cv-sec__title">Open source</h2>
      <ul class="cv-oss">
        {projects.slice(0, 3).map((p: any) => {
          const meta = [p.stars ? `${p.stars} stars` : '', p.forks ? `${p.forks} forks` : ''].filter(Boolean).join(' · ');
          return (
            <li>
              <a class="cv-oss__name" href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a>
              <span class="cv-oss__meta">{meta}</span>
              <span class="cv-oss__desc">— {p.description}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="cv-sec">
      <h2 class="cv-sec__title">Selected writing</h2>
      <ul class="cv-writing">
        {articles.slice(0, 3).map((a: any) => (
          <li>
            <a class="cv-writing__title" href={a.url} target="_blank" rel="noopener noreferrer">{a.title}</a>
            <span class="cv-writing__date">{monthYear(a.date)}</span>
          </li>
        ))}
      </ul>
      <p class="cv-writing__note">Essays on system design, AI tooling, and the developer craft — full archive at <a href="/">duthaho.dev</a>.</p>
    </section>
  </main>
</BaseLayout>

<script>
  document.getElementById('print-btn')?.addEventListener('click', () => window.print());
</script>

<style>
  /* Toolbar (screen only) */
  .cv-toolbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem clamp(1rem, 4vw, 2rem);
    background: color-mix(in oklab, var(--paper) 86%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule-soft);
    font-family: 'IBM Plex Mono', monospace;
  }
  .cv-toolbar a, .cv-toolbar__primary {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.82rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--rule-soft);
    border-radius: 6px;
    background: var(--paper-cream);
    color: var(--ink-soft);
    text-decoration: none;
    cursor: pointer;
  }
  .cv-toolbar a:hover, .cv-toolbar__primary:hover { border-color: var(--vermillion); }
  .cv-toolbar__primary { background: var(--vermillion); color: var(--paper-cream); border-color: var(--vermillion-deep); }
  .cv-toolbar__hint { margin-left: auto; font-size: 0.72rem; color: var(--ink-faint); }

  /* Sheet */
  .cv-page-sheet {
    max-width: 210mm;
    margin: 24px auto 64px;
    background: var(--paper-cream);
    border: 1px solid var(--rule-soft);
    border-radius: 10px;
    box-shadow: 0 8px 40px rgba(27, 24, 20, 0.08);
    padding: 16mm 17mm;
    color: var(--ink-soft);
    counter-reset: sec;
    font-size: 10.5pt;
    line-height: 1.5;
  }

  .cv-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px 24px; flex-wrap: wrap; border-bottom: 1.5px solid var(--ink); padding-bottom: 12px; margin-bottom: 14px; }
  .cv-head__name { font-family: 'Fraunces', serif; font-weight: 600; font-size: 26pt; line-height: 1.02; color: var(--ink); margin: 0 0 6px; }
  .cv-head__role { font-family: 'IBM Plex Mono', monospace; font-size: 9pt; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--vermillion); margin: 0 0 6px; }
  .cv-head__sheet { font-family: 'IBM Plex Mono', monospace; font-size: 8pt; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint); margin: 0; }
  .cv-head__contact { text-align: right; font-family: 'IBM Plex Mono', monospace; font-size: 8.5pt; color: var(--ink-mute); display: flex; flex-direction: column; gap: 3px; margin: 0; }
  .cv-head__contact a { color: var(--ink-soft); text-decoration: none; }
  .cv-head__contact a:hover { color: var(--vermillion); }

  .cv-stats { font-family: 'IBM Plex Mono', monospace; font-size: 8.5pt; color: var(--ink-mute); margin: 0 0 18px; display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .cv-stats span { display: inline-flex; align-items: center; gap: 6px; }
  .cv-stats b { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }

  .cv-sec { margin-bottom: 15px; }
  .cv-sec__title { counter-increment: sec; display: flex; align-items: baseline; gap: 0.55rem; font-family: 'Fraunces', serif; font-weight: 600; font-size: 13pt; color: var(--ink); border-bottom: 1px solid var(--rule-soft); padding-bottom: 4px; margin: 0 0 9px; }
  .cv-sec__title::before { content: counter(sec, decimal-leading-zero); font-family: 'IBM Plex Mono', monospace; font-size: 8pt; font-weight: 500; letter-spacing: 0.08em; color: var(--vermillion); flex: none; }

  .cv-summary { margin: 0; color: var(--ink-soft); max-width: 64em; }

  .cv-skills { display: flex; flex-direction: column; gap: 6px; }
  .cv-skills__row { display: flex; gap: 12px; }
  .cv-skills__label { font-family: 'IBM Plex Mono', monospace; font-size: 8pt; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-mute); min-width: 96px; padding-top: 2px; }
  .cv-skills__value { font-size: 10pt; color: var(--ink); }

  .cv-exp { position: relative; padding-left: 22px; }
  .cv-exp::before { content: ""; position: absolute; left: 3px; top: 6px; bottom: 6px; width: 1px; background: var(--rule-soft); }
  .cv-job { position: relative; margin-bottom: 14px; break-inside: avoid; }
  .cv-job:last-child { margin-bottom: 0; }
  .cv-job::before { content: ""; position: absolute; left: -22px; top: 0.34em; width: 8px; height: 8px; transform: rotate(45deg); background: var(--vermillion); box-shadow: 0 0 0 2.5px var(--paper-cream); }
  .cv-job__head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .cv-job__role { font-family: 'Fraunces', serif; font-weight: 600; font-size: 12pt; color: var(--ink); margin: 0; }
  .cv-job__co { font-family: 'Fraunces', serif; font-weight: 600; font-size: 11pt; color: var(--vermillion); }
  .cv-job__period { margin-left: auto; font-family: 'IBM Plex Mono', monospace; font-size: 8.5pt; color: var(--ink-mute); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .cv-job__summary { margin: 3px 0 6px; font-size: 9.8pt; color: var(--ink-soft); }
  .cv-job__bullets { margin: 0; padding-left: 15px; }
  .cv-job__bullets li { font-size: 9.8pt; line-height: 1.45; margin-bottom: 3px; color: var(--ink-soft); break-inside: avoid; }
  .cv-job__bullets :global(strong) { color: var(--ink); font-weight: 600; }
  .cv-job__stack { font-family: 'IBM Plex Mono', monospace; font-size: 8pt; color: var(--ink-mute); margin: 6px 0 0; }

  .cv-oss { margin: 0; padding: 0; list-style: none; }
  .cv-oss li { margin-bottom: 6px; break-inside: avoid; }
  .cv-oss__name { font-family: 'IBM Plex Mono', monospace; font-weight: 500; font-size: 9.5pt; color: var(--ink); text-decoration: none; }
  .cv-oss__name::before { content: "› "; color: var(--vermillion); }
  .cv-oss__name:hover { color: var(--vermillion); }
  .cv-oss__meta { font-family: 'IBM Plex Mono', monospace; font-size: 8pt; color: var(--ink-mute); margin-left: 8px; font-variant-numeric: tabular-nums; }
  .cv-oss__desc { color: var(--ink-soft); font-size: 9.5pt; }

  .cv-writing { margin: 0; padding: 0; list-style: none; }
  .cv-writing li { display: flex; align-items: baseline; gap: 12px; margin-bottom: 5px; break-inside: avoid; }
  .cv-writing__title { flex: 1 1 auto; color: var(--ink); font-size: 9.6pt; line-height: 1.4; text-decoration: none; }
  .cv-writing__title:hover { color: var(--vermillion); }
  .cv-writing__date { flex: none; font-family: 'IBM Plex Mono', monospace; font-size: 8pt; color: var(--ink-mute); white-space: nowrap; font-variant-numeric: tabular-nums; padding-top: 1px; }
  .cv-writing__note { margin: 8px 0 0; font-size: 9pt; color: var(--ink-mute); }
  .cv-writing__note a { color: var(--vermillion); }

  @media (max-width: 480px) {
    .cv-page-sheet { padding: 22px 18px; margin: 14px auto 28px; }
    .cv-head { align-items: flex-start; }
    .cv-head__contact { text-align: left; }
    .cv-toolbar__hint { display: none; }
  }

  /* Print — clean black-on-white, ATS-plain */
  @page { size: A4; margin: 0; }
  @media print {
    :global(body.cv-page .topbar), :global(body.cv-page footer), .cv-toolbar { display: none !important; }
    :global(body.cv-page) { background: #fff !important; }
    .cv-page-sheet {
      max-width: none; width: 100%; margin: 0; border: none; border-radius: 0; box-shadow: none;
      padding: 14mm 16mm; background: #fff; color: #33373d;
    }
    .cv-head__name, .cv-sec__title, .cv-job__role, .cv-skills__value, .cv-stats b, .cv-job__bullets :global(strong) { color: #14161a; }
    .cv-head__role, .cv-job__co, .cv-sec__title::before, .cv-oss__name::before, .cv-writing__note a { color: #15682d; }
    .cv-job::before { background: #1f8a3d; box-shadow: 0 0 0 2.5px #fff; }
    a { color: inherit; }
    .cv-page-sheet { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
